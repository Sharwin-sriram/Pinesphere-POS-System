# Local environment example for django_service
# Copy to .env and fill values before running migrations or server.

# ------------------------
# Django / App settings
# ------------------------
DEBUG=1
SECRET_KEY=replace-me-with-a-secure-key
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback

# ------------------------
# Database (Postgres - recommended)
# ------------------------
# Use Postgres in development by default. If you want SQLite for quick
# testing, override these values in your local .env.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pinesphere_db
DB_USER=pinesphere_user
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------
# Redis (caching, channels, celery)
# ------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYERS_REDIS=redis://127.0.0.1:6379/1

# ------------------------
# JWT / Security
# ------------------------
JWT_SECRET=your-shared-jwt-secret-here

# ------------------------
# CORS / Frontend
# ------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------
# Google OAuth (optional)
# ------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback/
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# ------------------------
# OTP SMS (Fast2SMS)
# ------------------------
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_DLT_SENDER_ID=your-dlt-sender-id
FAST2SMS_DLT_MESSAGE_ID=your-approved-message-id

# ------------------------
# Cloudinary (optional - media storage)
# ------------------------
# Set USE_CLOUDINARY to True to enable Cloudinary-backed media storage.
USE_CLOUDINARY=False
# Provide either individual credentials or a full CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ------------------------
# Email (optional)
# ------------------------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0

# ------------------------
# Observability / Alerts
# ------------------------
SENTRY_DSN=
ALERTS_EMAIL=

# ------------------------
# Payments (Razorpay)
# ------------------------
# Server-only secrets for payment gateway integration. Keep these private.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Notes:
# - This file is a template. Copy it to .env and update secrets before running.
# - If you prefer SQLite for quick local runs, set `DB_ENGINE=django.db.backends.sqlite3`
#   and `DB_NAME=db.sqlite3` in your local .env to override these defaults.
