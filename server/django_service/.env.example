# Local environment example for django_service
# Copy to .env and fill values before running migrations or server.

# Django
DEBUG=1
SECRET_KEY=replace-me-with-a-secure-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pinesphere_db
DB_USER=pinesphere_user
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (for channels, caching, celery, etc.)
REDIS_URL=redis://127.0.0.1:6379/0

# Channels
CHANNEL_LAYERS_REDIS=redis://127.0.0.1:6379/1

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0

# Other
SENTRY_DSN=
ALERTS_EMAIL=
SECRET_KEY=django-secret-key-here
DEBUG=True
FRONTEND_URL=http://localhost:3000
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback
# Client (Next.js): set in client/.env.local
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
DB_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your-shared-jwt-secret-here
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback/
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Cloudinary (for media storage)
# Set `USE_CLOUDINARY` to true to enable storing uploaded media on Cloudinary
USE_CLOUDINARY=False
# Either provide the individual credentials below or a single CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# or use a full URL: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# SQLite (auth service)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3